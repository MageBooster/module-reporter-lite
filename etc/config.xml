<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magebooster_reporterlite>
            <mail>
                <sender>general</sender>
                <max_attach_mb>10</max_attach_mb>
            </mail>
            <sql>
                <max_rows>5000</max_rows>
                <max_seconds>10</max_seconds>
            </sql>
            <files>
                <link_days>7</link_days>
                <history_days>90</history_days>
            </files>
        </magebooster_reporterlite>
    </default>
</config>
